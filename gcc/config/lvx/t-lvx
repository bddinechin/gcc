# Disable pedantic due to unwanted behavior of ISO C++11 with respect
# to variadic macros called with empty argument list.
# lvx-ftypes.def is a function of lvx-builtins.def alone -- every
# DEF_LVX_FTYPE exists because some builtin asks for that signature -- so it
# is generated here, into the build directory, rather than checked in.  It
# used to be an MDS BE/GCC product, which put a file whose only input is in
# this tree on the other side of a copy step that had to be remembered.
lvx-ftypes.def: $(srcdir)/config/lvx/lvx-builtins.def \
  $(srcdir)/config/lvx/gen-ftypes.awk
	LC_ALL=C $(AWK) -f $(srcdir)/config/lvx/gen-ftypes.awk \
	  $(srcdir)/config/lvx/lvx-builtins.def > tmp-lvx-ftypes.def
	$(SHELL) $(srcdir)/../move-if-change tmp-lvx-ftypes.def lvx-ftypes.def

lvx-builtins.o: $(srcdir)/config/lvx/lvx-builtins.cc \
  $(srcdir)/config/lvx/lvx-builtins.def lvx-ftypes.def $(CONFIG_H) \
  $(SYSTEM_H) coretypes.h $(TM_H) $(RTL_H) $(TREE_H) $(RECOG_H) langhooks.h \
  $(DIAGNOSTIC_CORE_H) $(OPTABS_H) $(srcdir)/config/lvx/lvx-modes.def
	$(COMPILER) -c $(ALL_COMPILERFLAGS) $(ALL_CPPFLAGS) $(INCLUDES) \
	-Wno-pedantic $(srcdir)/config/lvx/lvx-builtins.cc

# $(out_object_file): ALL_COMPILERFLAGS += -Werror

CFLAGS-mkoffload.o += $(DRIVER_DEFINES) \
	-DGCC_INSTALL_NAME=\"$(GCC_INSTALL_NAME)\"
mkoffload.o: $(srcdir)/config/lvx/mkoffload.cc
	$(COMPILE) $<
	$(POSTCOMPILE)
ALL_HOST_OBJS += mkoffload.o

mkoffload$(exeext): mkoffload.o collect-utils.o libcommon-target.a \
		      $(LIBIBERTY) $(LIBDEPS)
	+$(LINKER) $(ALL_LINKERFLAGS) $(LDFLAGS) -o $@ \
	  mkoffload.o collect-utils.o libcommon-target.a $(LIBIBERTY) $(LIBS)
