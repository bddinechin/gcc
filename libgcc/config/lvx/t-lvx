HOST_LIBGCC2_CFLAGS += -ffunction-sections -fdata-sections

# Nothing to exclude from soft-fp any more.  divsf3.c and divdf3.c used to
# replace the soft-fp versions with a Newton-Raphson sequence, but the backend
# expands divsf3/divdf3/divhf3 straight to fdivw/fdivd/fdivh (all lvx_v1), so
# no library routine is reached at all.  Same for square root now that
# sqrt<mode>2 emits fsqrth/fsqrtw/fsqrtd.
softfp_func_exclude :=
softfp_file_list := \
  $(filter-out $(addsuffix .c, \
                           $(addprefix $(srcdir)/soft-fp/, \
                                       $(softfp-func-exclude))), \
               $(softfp_file_list))

softfp_float_modes := sf df
softfp_int_modes := si di ti
softfp_extensions := sfdf
softfp_truncations := dfsf
softfp_extras := fixhfti fixunshfti floattihf floatuntihf
softfp_exclude_libgcc2 := n

# The vector divide/modulo helpers.
#
# divv.c is the lane-wise fallback and is built for BOTH multilibs: the middle
# end lowers a vector `a / b` to a __div<mode>3 call and LVX has no vector
# divide, so without it every one is a link-time undefined symbol.  It does one
# scalar fdiv/divmod per lane, which is core-agnostic -- a vector type declared
# by attribute works on lvx-1 too.  There is no other source for the
# floating-point ones anywhere.
#
# divmodvxqi.c is the STSU alternative.  It is correct and ready but NOT built,
# because the one instruction it ends on -- TRUNCHBX -- is wrong in the ISS:
# it copies the source's low 128 bits instead of packing the low bytes of all
# sixteen half-words, so result[2j] and result[2j+1] both come from half-word
# 2j.  TRUNCWHO and TRUNCDWQ are correct, and the generated execute body for
# TRUNCHBX reads correct, so the fault is downstream of the C.  Verified from
# hand-written assembly with the compiler out of the picture, and the divider
# itself was verified correct over 512 lane-checks with the final pack done in
# portable C instead.  Enable it here the moment TRUNCHBX executes correctly;
# until then divv.c must keep the byte lanes, or lvx-2 gets wrong answers where
# it currently gets right ones.  The algorithm
# (from the TMS320C5x guide) iterates once per bit of the lane with an STSU at
# twice the lane width, so its cost grows with the lane while the scalar route's
# falls -- 128/W divides for a W-bit lane.  Measured in bundles at -O2:
#
#                      STSU      one divmod per lane
#   __udivv16qi3         15       24       STSU 1.6x better
#   __udivv32qi3         30       66       STSU 2.2x better
#   __udivv8hi3          23       12       scalar 1.9x better
#   __udivv16hi3         46       20       scalar 2.3x better
#   __udivv4si3           -        8       scalar (4 divmodw, FULL slot)
#   __udivv2di3           -        5       scalar (2 divmodd)
#
# So the crossover sits between byte and half-word lanes, and only the QI file
# earns its place.  divv.c guards its own byte-lane helpers off on lvx-2 so the
# two never define the same symbol.
#
# divmodvxhi.c and divmodvxsi.c stay out on those numbers, not because they are
# broken -- both are now correct (see below) and compile and assemble clean.
# They are kept so the measurement can be repeated if the STSU latency or the
# LITE slot count ever changes.  What was wrong with them, and is now fixed:
# an inverted `#if defined(__lvxarch_lvx_1)` guard that compiled SIMD code on
# the core without SIMD and nothing on the core with it; a branch in the HI file
# that widened to FOUR times the lane width and called STSUDO (four STSUDP
# each); 256-bit paths that formed 512-bit values with no register home; and
# calls to __builtin_lvx_any*, which never existed -- harmless only because
# DIV_BY_ZERO_MAY_TRAP discards its arguments.
#
# A 64-bit lane cannot use this route at all: it would need a 128-bit STSU and
# the widest is STSUDP at 64.  divv.c covers V2DI/V4DI with two or four
# divmodd, which is cheap anyway.
#
# divmoddi.c and divmodsi.c are retired: they implemented 32- and 64-bit
# divide/modulo in software, by Newton-Raphson refinement of a reciprocal
# seed, and LVX has the operation in hardware -- divmodw, divmodd, divmoduw
# and divmodud, all on lvx_v1.  They were also the last users of
# __builtin_lvx_frec*, which no longer exists (LVX has only the seed form,
# fsrec*).  The div/mod expanders no longer call out to them: their
# optimize_size paths, the only ones that did, are gone.
#
# divsf3.c/divdf3.c were retired outright because they are genuinely
# unreachable: divsf3/divdf3/divhf3 expand straight to fdivw/fdivd/fdivh.
lvx-libgcc-funcs := \
  divv \
  $(softfp_func_exclude)

lvx-libgcc-c := $(addsuffix .c,$(lvx-libgcc-funcs))
lvx-libgcc-o := $(addsuffix .o,$(lvx-libgcc-funcs))
lvx-libgcc-files := $(addprefix $(srcdir)/config/lvx/, $(lvx-libgcc-c))

$(lvx-libgcc-o): CFLAGS += -Werror

LIB2ADD += $(lvx-libgcc-files)
LIB2FUNCS_EXCLUDE += $(addprefix _,$(softfp-func-exclude))

SHLIB_MAPFILES += $(srcdir)/config/lvx/libgcc-vector.ver

crtcxa.o: $(srcdir)/config/lvx/crtcxa.c
	$(crt_compile) -c $<

crtcxa_s.o: $(srcdir)/config/lvx/crtcxa.c
	$(crt_compile) -DSHARED -c $<
